# Day 1 HMAC Salt - provided on team slip at sprint start
# DAY1_SALT: read strictly from environment variable; NEVER commit your real team slip salt to any file.
DAY1_SALT=replace-with-your-team-slip-salt

# Database configuration (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nascon
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/nascon

# Redis 7 cache and rate-limiting
REDIS_URL=redis://redis:6379/0

# RabbitMQ 3.13 message broker
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# MinIO object storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Security / Authentication
JWT_SECRET=change-me-in-production-jwt-secret-min-32-chars

# CORS allowed origins (comma-separated, '*' for all)
CORS_ORIGINS=*
